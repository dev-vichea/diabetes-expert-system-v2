# ==============================================================================
# Vercel Production Environment Variables (diabetes-diagnosis)
# ==============================================================================
# In Vercel: Project Settings -> Environment Variables
# Copy and paste the key-value pairs below into Vercel.
# Select environments: Production, Preview, Development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend & Security (Flask Serverless)
# ------------------------------------------------------------------------------
FLASK_DEBUG=false
SECRET_KEY=hellohibyebye
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database (IPv4 Pooler URL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.pujclmfwdkuaxmhbllza:vichea123%3A%29@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Serverless optimizations (tables & facts are already seeded in Supabase):
DB_AUTO_CREATE=false
SEED_DEMO_DATA=false
RULES_SEED_VERSION=v2
DB_FALLBACK_ENABLED=false

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://diabetes-diagnosis.vercel.app,http://localhost:5173,http://localhost

# ------------------------------------------------------------------------------
# 4. Frontend Variables (Vite Build)
# ------------------------------------------------------------------------------
# Same-domain relative API path (no CORS issues when deployed together):
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=20000
